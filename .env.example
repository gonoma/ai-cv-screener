# Copy to .env and fill in what you need. .env is gitignored.

# Which provider generates the CV text: gemini | openrouter
# Default when unset: gemini
TEXT_PROVIDER=gemini

# Google AI Studio. Free tier is roughly 20 requests/minute and a low daily cap.
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys). Free models are 20
# requests/minute and 50/day, or 1000/day once the account has ever bought $10
# of credit.
OPENROUTER_API_KEY=

# Which rung of the photo chain to start on: gemini | pollinations | local.
# Failures fall through to the next rung.
# Default when unset: gemini
IMAGE_PROVIDER=gemini

# --- Backend token budget ----------------------------------------------------


# Caps one reply. Gemini counts thinking against this too, so too low truncates
# the answer mid-sentence. Only emitted tokens are billed.
LLM_MAX_OUTPUT_TOKENS=2000
GEMINI_THINKING_LEVEL=low
OPENROUTER_REASONING_EFFORT=off
LLM_TIMEOUT_SECONDS=300

# Chunks retrieved for open-ended questions, and the whole cost of that route:
# each one is up to 900 characters of prompt.
# Turn this down first when token budget bites.
SEMANTIC_SEARCH_TOP_K=8

# Postgres DB ENV VARS
POSTGRES_USER=cv
POSTGRES_PASSWORD=cv
POSTGRES_DB=cv
POSTGRES_PORT=5433

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
